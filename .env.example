# MediaSFU API credentials.
# Get production credentials from https://mediasfu.com.
MEDIASFU_API_USERNAME=your_api_username
MEDIASFU_API_KEY=your_64_character_api_key

# Optional MediaSFU Community Edition / self-hosted server.
# Leave empty for MediaSFU Cloud only.
MEDIASFU_LOCAL_LINK=

# Set true for MediaSFU Cloud or CE plus Cloud egress.
# Set false for self-hosted CE only.
MEDIASFU_CONNECT_MEDIASFU=true
